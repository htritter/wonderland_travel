# Supabase — use the "Session mode" pooler URL (port 6543) for DATABASE_URL
# and the direct connection URL (port 5432) for DIRECT_URL.
# Both are found in your Supabase project under Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Resend — https://resend.com/api-keys
RESEND_API_KEY="re_..."

# The email address where new quote notifications are sent (your inbox)
AGENT_EMAIL="you@example.com"

# The verified sender address in Resend (must match a verified domain or use onboarding@resend.dev for testing)
FROM_EMAIL="hello@thewonderlandtravel.com"
